# Copy to .env and fill in values. Never commit .env.

# --- App ---
# Public origin of the site (used for WebAuthn RP ID and absolute URLs)
APP_URL=https://wp.olliecross.com
# Secret used to sign session cookies (generate: openssl rand -hex 32)
SESSION_SECRET=changeme
# One-time token that guards the initial passkey registration route
SETUP_TOKEN=changeme

# --- PostgreSQL ---
POSTGRES_USER=wp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=wp
DATABASE_URL=postgresql://wp:changeme@postgres:5432/wp

# --- MinIO (S3) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=wp-files
S3_ACCESS_KEY=wp-minio
S3_SECRET_KEY=changeme

# Feature flags
# Beam rendering from MVR rigs (hidden by default; needs a rebuild to take effect)
NEXT_PUBLIC_ENABLE_BEAMS=false
