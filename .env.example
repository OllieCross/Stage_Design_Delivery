# Copy to .env and fill in values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=wp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=wp
DATABASE_URL=postgresql://wp:changeme@wp-postgres:5432/wp

# --- MinIO (S3) ---
S3_ENDPOINT=http://wp-minio:9000
S3_REGION=us-east-1
S3_BUCKET=wp-files
S3_ACCESS_KEY=wp-minio
S3_SECRET_KEY=changeme

# --- Login ---
# The project list and /edit need this login; project links stay public.
# SESSION_SECRET: any long random string (openssl rand -hex 32)
ADMIN_USER=
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Backups ---
# Hostname or IP of the NAS that receives nightly backups over NFS
NAS_HOST=

# Feature flags
# Beam rendering from MVR rigs (hidden by default; needs a rebuild to take effect)
NEXT_PUBLIC_ENABLE_BEAMS=false
